# Конфигурация окружения для Flask приложения "Крылья"
# Скопируйте этот файл в .env и измените значения по необходимости

# Окружение: development, production, или testing
FLASK_ENV=development

# Секретный ключ (ОБЯЗАТЕЛЬНО измените в продакшене!)
# Генерируйте случайный ключ командой: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Пароль редактора статей (страница входа: /admin/login)
ADMIN_PASSWORD=change-me

# Путь к SQLite. На сервере задайте папку, которую деплой не затирает.
# ARTICLES_DB_PATH=C:\deploy\data\articles.db

# Папка загруженных картинок галереи (тоже вне копируемых при деплое каталогов)
# GALLERY_UPLOAD_DIR=/var/www/cryiliya/data/uploads

# Ночной бэкап: scripts/backup.sh
# BACKUP_DIR=/var/backups/cryiliya
# BACKUP_KEEP_DAYS=21
# RCLONE_REMOTE=yandex:cryiliya-backups

# Публичный адрес сайта для sitemap
# SITE_URL=https://cryiliya.ru

# Для продакшена с Redis кэшем (опционально)
# REDIS_URL=redis://localhost:6379/0
